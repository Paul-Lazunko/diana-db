{
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "ES2022",
    "declaration": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "baseUrl": "./",
    "paths": {
      "@framework": ["src/aggregation-framework"],
      "@application": ["src/application"],
      "@collection": ["src/collection"],
      "@controller": ["src/controller"],
      "@config": ["src/config"],
      "@const": ["src/constants"],
      "@dto": ["src/dto"],
      "@database": ["src/database"],
      "@data-holder": ["src/data-holder"],
      "@error": ["src/error"],
      "@event-emitter": ["src/event-emitter"],
      "@field": ["src/field"],
      "@helper": ["src/helpers"],
      "@logger": ["src/logger"],
      "@options": ["src/options"],
      "@parameters": ["src/parameters"],
      "@query-processor": ["src/query-processor"],
      "@queue": ["src/queue"],
      "@server": ["src/server"],
      "@state": ["src/state"],
      "@store": ["src/store"],
      "@user-store": ["src/user-store"],
      "@validator": ["src/validator"]
    }
  },
  "include": ["src/**/*"]
}
